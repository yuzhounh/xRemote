<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:_1RM.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/1Remote;component/Resources/Theme/HelpButtons.xaml" />
        <ResourceDictionary Source="/1Remote;component/Resources/Theme/SectionExpander.xaml" />
        <ResourceDictionary Source="/1Remote;component/Resources/Theme/FormStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <controls:InstructionEditorHeight x:Key="InstructionEditorHeight" />
    <Style x:Key="EditorExpanderStyle" TargetType="Expander" BasedOn="{StaticResource SectionExpanderStyle}" />
    <Style x:Key="TechnicalDropdownItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemAccentStyle}">
        <Setter Property="controls:OriginalParameterHint.Value" Value="{Binding}" />
    </Style>
    <Style x:Key="EditorRowGrid" TargetType="Grid">
        <Setter Property="Height" Value="Auto" /><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="EditorRowGridTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
        <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}" /><Setter Property="Width" Value="140" />
        <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextAlignment" Value="Right" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style x:Key="EditorRowGridTitle2" TargetType="TextBlock" BasedOn="{StaticResource EditorRowGridTitle}">
        <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="TextAlignment" Value="Left" /><Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="EditorRowGridTitleFollowing" TargetType="TextBlock" BasedOn="{StaticResource EditorRowGridTitle}">
        <Setter Property="Width" Value="Auto" /><Setter Property="Margin" Value="12,0,12,0" />
    </Style>
    <Style x:Key="EditorRowGridInput" TargetType="Grid"><Setter Property="Width" Value="420" /></Style>
    <Style x:Key="EditorDescriptionText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Width" Value="420" /><Setter Property="Height" Value="Auto" />
        <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="TextAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="EditorGroupTextBlockTitle" TargetType="TextBlock" BasedOn="{StaticResource FormGroupHeadingStyle}">
        <Setter Property="Width" Value="Auto" /><Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeTitle}" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Margin" Value="0,15,0,15" />
    </Style>
</ResourceDictionary>
