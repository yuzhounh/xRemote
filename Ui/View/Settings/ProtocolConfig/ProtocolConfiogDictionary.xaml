<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:_1RM.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/1Remote;component/Resources/Theme/HelpButtons.xaml" />
        <ResourceDictionary Source="/1Remote;component/Resources/Theme/SectionExpander.xaml" />
        <ResourceDictionary Source="/1Remote;component/Resources/Theme/FormStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <controls:ProtocolCardWidthConverter x:Key="ProtocolCardWidthConverter" />
    <Style x:Key="ProtocolCardSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ProtocolCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ProtocolCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ProtocolCardBorderThickness}" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style x:Key="RunnerSettingsExpanderStyle" TargetType="controls:RunnerSettingsExpander" BasedOn="{StaticResource SectionExpanderStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="controls:RunnerSettingsExpander">
                <StackPanel>
                    <ToggleButton x:Name="HeaderToggle" Style="{StaticResource SectionExpanderHeaderStyle}"
                                  Background="{DynamicResource ProtocolNavHoverBrush}"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Content="{TemplateBinding Header}" HorizontalContentAlignment="Stretch"
                                  HorizontalAlignment="Center" Margin="15,6,15,6"
                                  Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                  FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource ProtocolCardWidthConverter}}" />
                    <ContentPresenter x:Name="SettingsContent" Visibility="Collapsed" ContentSource="Content" />
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="SettingsContent" Property="Visibility" Value="Visible" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <!-- The page owns scrolling; avoid the default ListBox ScrollViewer's inset. -->
    <ControlTemplate x:Key="ProtocolPairListTemplate" TargetType="ListBox"><ItemsPresenter /></ControlTemplate>

    <Style x:Key="ProtocolActionColumnStyle" TargetType="ColumnDefinition">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="SharedSizeGroup" Value="ExternalRunnerColumn3" />
    </Style>
    <Style x:Key="ProtocolActionRailStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="5,0,0,0" />
    </Style>


    <Style x:Key="GridOneRow" TargetType="Grid">
        <Setter Property="Height" Value="Auto"></Setter>
        <Setter Property="MinWidth" Value="300"></Setter>
        <Setter Property="MinHeight" Value="30"></Setter>
        <Setter Property="Margin">
            <Setter.Value>
                <Thickness Bottom="15"></Thickness>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextBlockTitleColumn" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="HorizontalAlignment" Value="Right"></Setter>
        <Setter Property="TextAlignment" Value="Right"></Setter>
        <Setter Property="TextWrapping" Value="Wrap"></Setter>
        <Setter Property="Width" Value="100"></Setter>
        <Setter Property="Margin" Value="20 0 10 0"></Setter>
    </Style>

    <Style x:Key="Block" TargetType="Grid">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource ProtocolCardWidthConverter}, FallbackValue=580}"></Setter>
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="Margin" Value="15 10 15 10"></Setter>
        <!--<Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" Opacity="0.5" ShadowDepth="5"></DropShadowEffect>
            </Setter.Value>
        </Setter>-->
    </Style>

<Style x:Key="LeftAlignedAddButtonStyle" TargetType="Button" BasedOn="{StaticResource FormInlineAddButtonStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="controls:BindableAvalonEditor">
        <Setter Property="MinWidth" Value="100"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
    </Style>
</ResourceDictionary>
