<dialogs:DialogWindowBase xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:_1RM.View.Utils"
    x:Class="_1RM.View.Utils.AlternateAddressSwitchingView"
    Title="{Binding Title}" Width="440" Topmost="True">
    <dialogs:DialogWindowBase.Resources>
        <BooleanToVisibilityConverter x:Key="ConnectionCheckVisibility" />
    </dialogs:DialogWindowBase.Resources>
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusIcon}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                <Setter Property="Foreground" Value="#D64545" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,10,0,14"
            Visibility="{Binding IsChecking, Converter={StaticResource ConnectionCheckVisibility}}">
            <ProgressBar Height="3" IsIndeterminate="{Binding IsChecking}" />
            <TextBlock Text="{Binding RemainingText}" Margin="0,6,0,0" Opacity="0.65"
                Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource GlobalFontSizeSmall}" />
        </StackPanel>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding PingTestItems}" Margin="0,8,0,0" MaxHeight="260">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                            Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Address, Mode=OneWay}" IsReadOnly="True"
                            BorderThickness="0" Background="Transparent" Padding="0,4"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            ToolTip="{DynamicResource ConnectionCheck.CopyHint}" />
                        <TextBlock Text="{Binding StatusText}" Opacity="0.65"
                            Foreground="{DynamicResource PrimaryTextBrush}" FontSize="{DynamicResource GlobalFontSizeSmall}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="3" Visibility="{Binding HasFailed, Converter={StaticResource ConnectionCheckVisibility}}">
            <TextBlock Text="{DynamicResource ConnectionCheck.Unavailable}" TextWrapping="Wrap"
                Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.7" Margin="0,2,0,14" />
            <Button Content="{DynamicResource ConnectionCheck.Retry}" Command="{Binding CmdRetry}"
                HorizontalAlignment="Right" MinWidth="100" Height="34" />
        </StackPanel>
    </Grid>
</dialogs:DialogWindowBase>
