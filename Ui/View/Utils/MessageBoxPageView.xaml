<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:_1RM.View.Utils" xmlns:service="clr-namespace:_1RM.Service" xmlns:xaml="https://github.com/canton7/Stylet" xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources" x:Class="_1RM.View.Utils.MessageBoxPageView" FlowDirection="{Binding FlowDirection}">

    <StackPanel Margin="24,20,24,20">
        <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="{Binding TextAlignment}" Foreground="{DynamicResource BackgroundTextBrush}" />
        </ScrollViewer>
        <ItemsControl ItemsSource="{Binding ButtonList}" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding Label}" MinWidth="88" MinHeight="32" Padding="14,6" Margin="8,0,0,0" Style="{StaticResource ButtonPrimaryStyle}"
                        Command="{xaml:Action ButtonClicked}" CommandParameter="{Binding Value}">
                    <Button.IsDefault><MultiBinding Converter="{x:Static xaml:EqualityConverter.Instance}"><Binding /><Binding Path="DataContext.DefaultButton" RelativeSource="{RelativeSource AncestorType=UserControl}" /></MultiBinding></Button.IsDefault>
                </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
