<dialogs:DialogWindowBase xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:styles="clr-namespace:Shawn.Utils.WpfResources.Theme.Styles;assembly=Shawn.Utils.WpfResources" xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources" xmlns:editor="clr-namespace:_1RM.View.Editor" xmlns:controls="clr-namespace:_1RM.Controls" xmlns:dialogs="clr-namespace:_1RM.View.Utils" x:Class="_1RM.View.Editor.PasswordPopupDialogView" Title="{Binding Title}" Topmost="True" Width="500">
<Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="MinWidth" Value="50" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="WrapWithOverflow" />
            <Setter Property="Margin" Value="10 10" />
        </Style>
    </Window.Resources>

<Grid Margin="24,16,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Grid.Row="0" Margin="10 5" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Row="1" Text="{DynamicResource User}" />
                    <TextBox Name="TbUserName" Grid.Row="1" Grid.Column="1" Height="30" Margin="3 5 10 5" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" KeyDown="TbUserName_OnKeyDown" />


                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Password}" />


                    <controls:PasswordInput x:Name="TbPwd" Visibility="{Binding UsePrivateKeyForConnect, Converter={StaticResource ConverterBool2VisibleInv}}" Grid.Row="2" Grid.Column="1" Margin="3 5 10 5" Height="30" KeyDown="TbPwd_OnKeyDown" Password="{Binding Password, UpdateSourceTrigger=PropertyChanged,Mode=TwoWay }" />


                    <Grid Grid.Row="2" Grid.Column="1" Margin="3 5 10 5" Visibility="{Binding UsePrivateKeyForConnect, Converter={StaticResource ConverterBool2Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Name="TbPrivateKey" Text="{Binding PrivateKey}" Height="30" />
                        <Button Grid.Column="1" MinHeight="32" Padding="14,6" Content="{DynamicResource Select}" Click="ButtonOpenPrivateKey_OnClick" Style="{StaticResource ButtonPrimaryStyle}" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        </Button>
                    </Grid>

                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0 5 0 5" Name="CbUsePrivateKeyForConnect" Visibility="{Binding CanUsePrivateKeyForConnect, Converter={StaticResource ConverterBool2Visible}}" IsChecked="{Binding UsePrivateKeyForConnect}" Content="{DynamicResource 'Use private key'}">
                    </CheckBox>

                    <CheckBox Grid.Row="4" Grid.Column="1" Margin="0 5 0 5" Name="CbRememberMe" Visibility="{Binding CanRememberInfo, Converter={StaticResource ConverterBool2Visible}}" IsChecked="{Binding IsRememberInfo}">
                        <TextBlock Text="{DynamicResource 'Remember the information above'}" TextAlignment="Left" TextWrapping="Wrap" Margin="0" />
                    </CheckBox>
                </Grid>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16,8,16,12">
                    <Button Name="BtnSave" Command="{Binding CmdSave}" MinWidth="88" MinHeight="32" Padding="14,6" Content="{DynamicResource OK}" />
                </WrapPanel>
            </Grid>

</dialogs:DialogWindowBase>
