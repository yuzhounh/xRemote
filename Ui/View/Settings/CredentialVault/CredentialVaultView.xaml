<UserControl x:Class="_1RM.View.Settings.CredentialVault.CredentialVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_1RM.View.Settings.CredentialVault"
             xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
             xmlns:credentialVault="clr-namespace:_1RM.View.Settings.CredentialVault"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance credentialVault:CredentialVaultViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/1Remote;component/Resources/Theme/SettingsForm.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource SettingsFormLabelColumnStyle}" /><ColumnDefinition Style="{StaticResource SettingsFormInputColumnStyle}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource 'Credentials Vault'}" Style="{StaticResource SettingsFormHeadingStyle}" />
        <DataGrid x:Name="CredentialsGrid" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,24,0" AutoGenerateColumns="False"
                  HorizontalAlignment="Stretch" 
                  HorizontalContentAlignment="Stretch" 
                  CanUserSortColumns="False"
                  CanUserResizeColumns="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="False"
                  ColumnWidth="*"
                  IsReadOnly="True"
                  ItemsSource="{Binding Credentials}" >
            <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellBaseStyle}">
                <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
            </Style></DataGrid.CellStyle>
            <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource DataGridBaseStyle}">
                <Setter Property="HeadersVisibility" Value="Column" />
                <Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="HeadersVisibility" Value="None" /></Trigger></Style.Triggers>
            </Style></DataGrid.Style>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Grid MinHeight="35">
                                    <TextBlock Text="{TemplateBinding  Content}" 
                                               FontSize="{DynamicResource GlobalFontSizeSubtitle}" FontWeight="Bold"
                                               LineHeight="{DynamicResource GlobalFontSizeSubtitle}"
                                               Foreground="{DynamicResource BackgroundTextBrush}"
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Left" 
                                               TextWrapping="WrapWithOverflow"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>


            <DataGrid.Columns>

                <DataGridTemplateColumn MinWidth="100" MaxWidth="200" Header="{DynamicResource 'Data Source name'}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DataSource.DataSourceName}" MaxWidth="180" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn MinWidth="100" MaxWidth="240" Header="{DynamicResource Name}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding  Credential.Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn MinWidth="100" MaxWidth="240" Header="{DynamicResource User}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Credential.UserName}" MinWidth="100" MaxWidth="220" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Width="100" Header="{DynamicResource Password}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Left" MinWidth="100" MaxWidth="220">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="******"></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=Credential.Password}" Value="">
                                                <Setter Property="Text" Value=""></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="100" Header="{DynamicResource 'Private key'}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Left" MinWidth="100" MaxWidth="220">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="******"></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=Credential.PrivateKeyPath}" Value="">
                                                <Setter Property="Text" Value=""></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="Auto" MinWidth="100" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinWidth="100" MaxWidth="220">
                                <Button Content="{DynamicResource Edit}"
                                        Margin="5"
                                        Command="{Binding Path=DataContext.CmdEdit, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" 
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonAccentStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=DataSource.IsWritable}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{DynamicResource Delete}" 
                                        Margin="5"
                                        Command="{Binding Path=DataContext.CmdDelete, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" 
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonAccentStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=DataSource.IsWritable}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="EmptyCredentialsNote" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                   Margin="0,12,24,12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{DynamicResource Settings.EmptyCredentials}">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=CredentialsGrid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
        </TextBlock>


        <StackPanel x:Name="CredentialAddActions" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MinHeight="40" HorizontalAlignment="Left">
            <!--ADD BUTTON-->
            <Button Command="{Binding CmdAdd}" Style="{StaticResource SettingsAddButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" VerticalAlignment="Center" Data="{StaticResource FormAddGeometry}"
                          Stroke="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" />
                    <TextBlock Margin="5,0,0,0" HorizontalAlignment="Left" Text="{DynamicResource Add}" Foreground="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}"></TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
