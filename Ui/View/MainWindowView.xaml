<styles:WindowChromeBase x:Class="_1RM.View.MainWindowView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
                         xmlns:s="https://github.com/canton7/Stylet"
                         xmlns:view="clr-namespace:_1RM.View"
                         xmlns:styles="clr-namespace:Shawn.Utils.WpfResources.Theme.Styles;assembly=Shawn.Utils.WpfResources"
                         xmlns:service="clr-namespace:_1RM.Service"
                         xmlns:Rm="clr-namespace:_1RM"
                         xmlns:locality="clr-namespace:_1RM.Service.Locality"
                         xmlns:branding="clr-namespace:_1RM.Controls"
                         mc:Ignorable="d"
                         WindowStyle="SingleBorderWindow"
                         WindowChrome.WindowChrome="{x:Null}"
                         BorderThickness="0"
                         BorderBrush="Transparent"
                         Background="{DynamicResource BackgroundBrush}"
                         KeyDown="MainWindow_OnKeyDown"
                         d:DataContext="{d:DesignInstance view:MainWindowViewModel}"
                         Style="{StaticResource WindowChromeBaseBaseStyle}"
                         Title="{x:Static Rm:AppVersion.ProductDisplayName}"
                         Height="560" Width="900" 
                         MinWidth="300" MinHeight="300">
    <styles:WindowChromeBase.Template>
        <ControlTemplate TargetType="styles:WindowChromeBase">
            <ContentPresenter />
        </ControlTemplate>
    </styles:WindowChromeBase.Template>
    <styles:WindowChromeBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/1Remote;component/Resources/Theme/NativeCaption.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MenuSelectionMarkStyle" TargetType="Path">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Data" Value="{StaticResource GeometryHook}" />
                <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>
            <Style x:Key="UniformOptionMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MenuItemPrimaryStyle}">
                <Setter Property="MinWidth" Value="100" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeBody}" />
                <Setter Property="FontStyle" Value="Normal" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="MenuDividerStyle" TargetType="Separator">
                <Setter Property="Height" Value="17" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource MenuDividerBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ConnectionSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxAccentStyle}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="3,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                <TextBlock x:Name="SearchHint" Text="{TemplateBinding Tag}" FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}" FontWeight="Normal" Margin="{TemplateBinding Padding}"
                                           Foreground="{TemplateBinding Foreground}" Opacity="0.72" Visibility="Collapsed"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value=""><Setter TargetName="SearchHint" Property="Visibility" Value="Visible" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <RoutedUICommand x:Key="CommandFocusFilter" Text="Focus on filter" />
        </ResourceDictionary>
    </styles:WindowChromeBase.Resources>
    <styles:WindowChromeBase.CommandBindings>
        <CommandBinding Command="{StaticResource CommandFocusFilter}" Executed="CommandFocusFilter_OnExecuted"></CommandBinding>
    </styles:WindowChromeBase.CommandBindings>
    <styles:WindowChromeBase.InputBindings>
        <!-- map ctrl + f to focus on filter-->
        <KeyBinding Gesture="Ctrl+F" Command="{StaticResource CommandFocusFilter}"></KeyBinding>
    </styles:WindowChromeBase.InputBindings>

    <Grid Background="{DynamicResource PrimaryMidBrush}">
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <BlurEffect Radius="2" KernelType="Box"></BlurEffect>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=TopLevelViewModel, Mode=OneWay}" Value="{x:Null}">
                            <Setter Property="Effect" Value="{x:Null}"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="NativeCaptionRow" Height="48" />
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" Name="WinTitleBar">
                <StackPanel Orientation="Horizontal">
                    <Grid Background="Transparent" Width="24" Height="24" Margin="5">
                        <branding:AppLogo x:Name="TitleLogo" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0"
                               Style="{StaticResource TextBlockBase}"
                               Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Title, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" />
                </StackPanel>
            </Grid>

            <!-- System Button Area -->
            <StackPanel x:Name="CaptionMenuArea" Grid.Row="0" Margin="0,0,138,0"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Grid Width="{DynamicResource NativeCaptionButtonWidth}" Height="{DynamicResource NativeCaptionButtonHeight}"
                      Margin="0" VerticalAlignment="Center">
                    <CheckBox Name="CbPopForMenu" Style="{StaticResource NativeCaptionMenuStyle}">
                        <Path Width="12" Height="12" Data="M1,2.5 H11 M1,6 H11 M1,9.5 H11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}"
                              StrokeThickness="1" Stretch="None" SnapsToDevicePixels="True" />
                    </CheckBox>

                    <Grid Width="15" Height="15">
                        <Path Data="F1 M 10 3.4375 C 10.605469 3.4375 11.186523 3.515625 11.743164 3.671875 C 12.299805 3.828125 12.822266 4.049479 13.310547 4.335938 C 13.798828 4.622396 14.241536 4.964193 14.638672 5.361328 C 15.035807 5.758464 15.377604 6.201172 15.664063 6.689453 C 15.950521 7.177734 16.171875 7.700195 16.328125 8.256836 C 16.484375 8.813477 16.5625 9.394531 16.5625 10 C 16.5625 10.605469 16.484375 11.186523 16.328125 11.743164 C 16.171875 12.299805 15.950521 12.822266 15.664063 13.310547 C 15.377604 13.798828 15.035807 14.241537 14.638672 14.638672 C 14.241536 15.035808 13.798828 15.377604 13.310547 15.664063 C 12.822266 15.950521 12.299805 16.171875 11.743164 16.328125 C 11.186523 16.484375 10.605469 16.5625 10 16.5625 C 9.394531 16.5625 8.813477 16.484375 8.256836 16.328125 C 7.700195 16.171875 7.177734 15.950521 6.689453 15.664063 C 6.201172 15.377604 5.758463 15.035808 5.361328 14.638672 C 4.964192 14.241537 4.622396 13.798828 4.335938 13.310547 C 4.049479 12.822266 3.828125 12.299805 3.671875 11.743164 C 3.515625 11.186523 3.4375 10.605469 3.4375 10 C 3.4375 9.394531 3.515625 8.813477 3.671875 8.256836 C 3.828125 7.700195 4.049479 7.177734 4.335938 6.689453 C 4.622396 6.201172 4.964192 5.758464 5.361328 5.361328 C 5.758463 4.964193 6.201172 4.622396 6.689453 4.335938 C 7.177734 4.049479 7.700195 3.828125 8.256836 3.671875 C 8.813477 3.515625 9.394531 3.4375 10 3.4375 Z "
                              Fill="Red"
                              Stretch="Uniform"
                              Width="6"
                              Margin="0 -3 -3 0"
                              VerticalAlignment="Top" HorizontalAlignment="Right">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AboutViewModel.NewVersion}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Grid>

                <Popup Name="PopupMenu"
                       AllowsTransparency="True"
                       IsOpen="{Binding ElementName=CbPopForMenu, Path=IsChecked}"
                       StaysOpen="False"
                       PlacementTarget="{Binding ElementName=CbPopForMenu}">
                    <Border CornerRadius="8" Padding="4" BorderThickness="1" BorderBrush="{DynamicResource MenuBorderBrush}" Background="{DynamicResource MenuSurfaceBrush}">
                        <StackPanel Orientation="Vertical" MinWidth="138">
                            <MenuItem Header="搜索" InputGestureText="Ctrl+F" Click="SearchConnections_OnClick" />
                            <Separator Style="{StaticResource MenuDividerStyle}" />

                            <MenuItem x:Name="ViewOptionsMenu" Header="{DynamicResource ListViewMode}">
                                <MenuItem.Resources>
                                </MenuItem.Resources>
                                <MenuItem Style="{StaticResource UniformOptionMenuItemStyle}" Header="{DynamicResource ListViewMode_Card}" Command="{Binding CmdToggleCardView}">
                                    <MenuItem.Icon>
                                        <Path>
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource MenuSelectionMarkStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentView}" Value="Card">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Style="{StaticResource UniformOptionMenuItemStyle}" Header="{DynamicResource ListViewMode_List}" Command="{Binding CmdToggleListView}">
                                    <MenuItem.Icon>
                                        <Path>
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource MenuSelectionMarkStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentView}" Value="List">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Style="{StaticResource UniformOptionMenuItemStyle}" Header="{DynamicResource ListViewMode_Tree}" Command="{Binding CmdToggleTreeView}">
                                    <MenuItem.Icon>
                                        <Path>
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource MenuSelectionMarkStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentView}" Value="Tree">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem x:Name="SortOptionsMenu" Header="{DynamicResource Sorting}">
                                <MenuItem.Resources>
                                    <Style TargetType="Path" x:Key="HeaderPathStyle">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                        <Setter Property="Width" Value="20" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="5,0,5,0" />
                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                    </Style>
                                </MenuItem.Resources>
                                <MenuItem Style="{StaticResource UniformOptionMenuItemStyle}" Command="{Binding CmdChooseSortField}" CommandParameter="{x:Static locality:EnumServerOrderBy.IdAsc}">
                                    <MenuItem.Icon>
                                        <Path>
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource MenuSelectionMarkStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ServerOrderBy}" Value="{x:Static locality:EnumServerOrderBy.IdAsc}">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ServerOrderBy}" Value="{x:Static locality:EnumServerOrderBy.IdDesc}">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left" Text="{DynamicResource Settings.RecordId}"></TextBlock>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>



                                <MenuItem Style="{StaticResource UniformOptionMenuItemStyle}" Command="{Binding CmdChooseSortField}" CommandParameter="{x:Static locality:EnumServerOrderBy.ProtocolAsc}">
                                    <MenuItem.Icon>
                                        <Path>
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource MenuSelectionMarkStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ServerOrderBy}" Value="{x:Static locality:EnumServerOrderBy.ProtocolAsc}">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ServerOrderBy}" Value="{x:Static locality:EnumServerOrderBy.ProtocolDesc}">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left" Text="{DynamicResource Protocol}"></TextBlock>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>


                                <MenuItem Style="{StaticResource UniformOptionMenuItemStyle}" Command="{Binding CmdChooseSortField}" CommandParameter="{x:Static locality:EnumServerOrderBy.NameAsc}">
                                    <MenuItem.Icon>
                                        <Path>
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource MenuSelectionMarkStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ServerOrderBy}" Value="{x:Static locality:EnumServerOrderBy.NameAsc}">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ServerOrderBy}" Value="{x:Static locality:EnumServerOrderBy.NameDesc}">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left" Text="{DynamicResource Name}"></TextBlock>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>


                                <MenuItem Style="{StaticResource UniformOptionMenuItemStyle}" Command="{Binding CmdChooseSortField}" CommandParameter="{x:Static locality:EnumServerOrderBy.AddressAsc}">
                                    <MenuItem.Icon>
                                        <Path>
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource MenuSelectionMarkStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ServerOrderBy}" Value="{x:Static locality:EnumServerOrderBy.AddressAsc}">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ServerOrderBy}" Value="{x:Static locality:EnumServerOrderBy.AddressDesc}">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left" Text="{DynamicResource Hostname}"></TextBlock>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>


                                <MenuItem Style="{StaticResource UniformOptionMenuItemStyle}" Command="{Binding CmdChooseSortField}" CommandParameter="{x:Static locality:EnumServerOrderBy.Custom}">
                                    <MenuItem.Icon>
                                        <Path>
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource MenuSelectionMarkStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ServerOrderBy}" Value="{x:Static locality:EnumServerOrderBy.Custom}">
                                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </MenuItem.Icon>
                                    <MenuItem.Header>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left" Text="{DynamicResource 'Sort by drag'}"></TextBlock>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator Style="{StaticResource MenuDividerStyle}" />
                                <MenuItem Style="{StaticResource UniformOptionMenuItemStyle}" IsCheckable="True"
                                          IsChecked="{Binding IsSortDescending, Mode=TwoWay}"
                                          IsEnabled="{Binding CanChangeSortDirection}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource MenuSelectionMarkStyle}"
                                              Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}, Converter={StaticResource ConverterBool2Visible}}" />
                                    </MenuItem.Icon>
                                    <MenuItem.Header><TextBlock Text="降序排列" HorizontalAlignment="Left" /></MenuItem.Header>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem x:Name="ThemePresetMenu" Header="{DynamicResource Theme}" />
                            <Separator Style="{StaticResource MenuDividerStyle}" />
                            <MenuItem Header="{DynamicResource Options}" Command="{Binding CmdGoSysOptionsPage}" />
                            <MenuItem Command="{Binding CmdGoAboutPage}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource About}" VerticalAlignment="Center"></TextBlock>
                                        <Path Fill="Red" Margin="5 0"
                                              Data="F1 M 10 3.4375 C 10.605469 3.4375 11.186523 3.515625 11.743164 3.671875 C 12.299805 3.828125 12.822266 4.049479 13.310547 4.335938 C 13.798828 4.622396 14.241536 4.964193 14.638672 5.361328 C 15.035807 5.758464 15.377604 6.201172 15.664063 6.689453 C 15.950521 7.177734 16.171875 7.700195 16.328125 8.256836 C 16.484375 8.813477 16.5625 9.394531 16.5625 10 C 16.5625 10.605469 16.484375 11.186523 16.328125 11.743164 C 16.171875 12.299805 15.950521 12.822266 15.664063 13.310547 C 15.377604 13.798828 15.035807 14.241537 14.638672 14.638672 C 14.241536 15.035808 13.798828 15.377604 13.310547 15.664063 C 12.822266 15.950521 12.299805 16.171875 11.743164 16.328125 C 11.186523 16.484375 10.605469 16.5625 10 16.5625 C 9.394531 16.5625 8.813477 16.484375 8.256836 16.328125 C 7.700195 16.171875 7.177734 15.950521 6.689453 15.664063 C 6.201172 15.377604 5.758463 15.035808 5.361328 14.638672 C 4.964192 14.241537 4.622396 13.798828 4.335938 13.310547 C 4.049479 12.822266 3.828125 12.299805 3.671875 11.743164 C 3.515625 11.186523 3.4375 10.605469 3.4375 10 C 3.4375 9.394531 3.515625 8.813477 3.671875 8.256836 C 3.828125 7.700195 4.049479 7.177734 4.335938 6.689453 C 4.622396 6.201172 4.964192 5.758464 5.361328 5.361328 C 5.758463 4.964193 6.201172 4.622396 6.689453 4.335938 C 7.177734 4.049479 7.700195 3.828125 8.256836 3.671875 C 8.813477 3.515625 9.394531 3.4375 10 3.4375 Z "
                                              Stretch="Uniform"
                                              Width="6"
                                              VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AboutViewModel.NewVersion}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </StackPanel>
                    </Border>
                </Popup>

            </StackPanel>


            <!-- Paging Area -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="1" KernelType="Box"></BlurEffect>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TopLevelViewModel, Mode=OneWay}" Value="{x:Null}">
                                <Setter Property="Effect" Value="{x:Null}"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ContentControl s:View.Model="{Binding ActiveServerViewModel}"/>


                <ContentControl s:View.Model="{Binding SettingViewModel}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSetting}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="00:00:0.1" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ThicknessAnimation BeginTime="0:0:0.0" Storyboard.TargetProperty="Margin" From="1000 0 0 0" To="0" Duration="0:0:0.5"></ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard >
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0 0 0 0" To="1000 0 0 0" Duration="0:0:0.3"></ThicknessAnimation>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="00:00:0.5" Value="{x:Static Visibility.Collapsed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl s:View.Model="{Binding EditorViewModel}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EditorViewModel}" Value="{x:Null}">
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ThicknessAnimation Storyboard.TargetProperty="Margin" AccelerationRatio="0.9" From="1000 0 0 0" To="0" Duration="0:0:0.5"></ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
            <Grid x:Name="ConnectionSearchBar" Grid.Row="0" Panel.ZIndex="100"
                  Visibility="Collapsed" Width="360" Height="36" Margin="0,4,0,4"
                  HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True"
                  TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
                <Border CornerRadius="10" Background="{DynamicResource PrimaryDarkBrush}" IsHitTestVisible="False">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" /></Border.Effect>
                </Border>
                <Border CornerRadius="10" Background="{DynamicResource PrimaryDarkBrush}"
                        BorderBrush="{DynamicResource PrimaryLightBrush}" BorderThickness="1" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchConnectionsTextBox" BorderThickness="0"
                                 Style="{StaticResource ConnectionSearchTextBoxStyle}" Background="Transparent"
                                 Text="{Binding MainFilterString, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="搜索名称、目标或账户" KeyUp="MainFilter_OnKeyUp" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ConnectionSearchSummary}" Margin="10,0" FontSize="14"
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Width="1" Background="{DynamicResource PrimaryLightBrush}" Margin="0,2,6,2" />
                        <Button Grid.Column="3" Content="×" Width="28" FontSize="18" ToolTip="关闭搜索 (Esc)"
                                Style="{StaticResource ButtonBarPrimaryStyle}" Click="CloseConnectionSearch_OnClick" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Background="Transparent">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"></Setter>
                    <Setter Property="Background" Value="Transparent"></Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=TopLevelViewModel, Mode=OneWay}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ContentControl PreviewMouseDown="ProcessingRing_OnPreviewMouseDown"
                            PreviewMouseMove="WinTitleBar_OnPreviewMouseMove"
                            s:View.Model="{Binding TopLevelViewModel}"></ContentControl>
        </Grid>

    </Grid>
</styles:WindowChromeBase>
