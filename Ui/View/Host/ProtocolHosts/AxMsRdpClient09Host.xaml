<protocolHosts1:HostBase x:Class="_1RM.View.Host.ProtocolHosts.AxMsRdpClient09Host"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:protocolHosts1="clr-namespace:_1RM.View.Host.ProtocolHosts"
                  mc:Ignorable="d" 
                  d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="Grid">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="NetworkAdviceBanner" Grid.Row="0" Visibility="Collapsed" Padding="10,6"
                Background="{DynamicResource MenuSurfaceBrush}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource Remote.NetworkKeep}" Click="NetworkAdviceDismiss_OnClick"/>
                <Button x:Name="NetworkAdviceApply" DockPanel.Dock="Right" Margin="8,0,0,0" Click="NetworkAdviceApply_OnClick"/>
                <TextBlock x:Name="NetworkAdviceText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </DockPanel>
        </Border>
        <WindowsFormsHost x:Name="RdpHost" Grid.Row="1"/>
        <Control Name="GridLoading" Grid.Row="1" Style="{StaticResource BusyAnimationStyle}" Background="Black"/>
        <Grid Name="GridMessageBox" Grid.Row="1" Background="Black">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.1*" MaxWidth="100" MinWidth="20"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="0.1*" MaxWidth="100" MinWidth="20"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Name="TbMessageTitle" FontSize="{DynamicResource GlobalFontSizeTitle}" HorizontalAlignment="Center" Text="" Foreground="White" Margin="10"></TextBlock>
                <TextBlock Name="TbMessage" FontSize="{DynamicResource GlobalFontSizeSubtitle}" HorizontalAlignment="Center" Text="" Foreground="White" Margin="5" TextWrapping="WrapWithOverflow"></TextBlock>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 20 0 0">
                    <Button x:Name="BtnReconn" Click="BtnReconn_OnClick" Style="{StaticResource ButtonPrimaryStyle}" Width="80" Margin="5" Content="{DynamicResource Reconnect}"></Button>
                    <Button x:Name="BtnCancel" Click="BtnCancel_OnClick" Style="{StaticResource ButtonPrimaryStyle}" Width="80" Margin="5" Content="{DynamicResource Dismiss}"></Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</protocolHosts1:HostBase>
