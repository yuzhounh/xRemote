<UserControl x:Class="_1RM.View.Settings.SettingsPageView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:s="https://github.com/canton7/Stylet" xmlns:view="clr-namespace:_1RM.View">
 <UserControl.Resources>
  <Style x:Key="SettingsNavigationStyle" TargetType="Button">
   <Setter Property="Height" Value="44" /><Setter Property="Padding" Value="18,0" />
   <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" /><Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeBody}" />
   <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="Background" Value="Transparent" />
   <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" /></Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SettingsNavHoverBrush}" /></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Background="{DynamicResource BackgroundBrush}" Grid.IsSharedSizeScope="True">
  <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <StackPanel Background="{DynamicResource PrimaryMidBrush}">
   <Button Content="{DynamicResource system_options_general_title}" Command="{Binding CmdShowPage}" CommandParameter="{x:Static view:EnumMainWindowPage.SettingsGeneral}">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsNavigationStyle}"><Style.Triggers>
     <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static view:EnumMainWindowPage.SettingsGeneral}"><Setter Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" /><Setter Property="FontWeight" Value="Medium" /></DataTrigger>
    </Style.Triggers></Style></Button.Style>
   </Button>
   <Button Content="{DynamicResource Settings.Appearance}" Command="{Binding CmdShowPage}" CommandParameter="{x:Static view:EnumMainWindowPage.SettingsTheme}">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsNavigationStyle}"><Style.Triggers>
     <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static view:EnumMainWindowPage.SettingsTheme}"><Setter Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" /><Setter Property="FontWeight" Value="Medium" /></DataTrigger>
    </Style.Triggers></Style></Button.Style>
   </Button>
   <Button Content="{DynamicResource Settings.DataAndCredentials}" Command="{Binding CmdShowPage}" CommandParameter="{x:Static view:EnumMainWindowPage.SettingsData}">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsNavigationStyle}"><Style.Triggers>
     <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static view:EnumMainWindowPage.SettingsData}"><Setter Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" /><Setter Property="FontWeight" Value="Medium" /></DataTrigger>
    </Style.Triggers></Style></Button.Style>
   </Button>
   <Button Content="{DynamicResource Protocol}" Command="{Binding CmdShowPage}" CommandParameter="{x:Static view:EnumMainWindowPage.SettingsRunners}">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsNavigationStyle}"><Style.Triggers>
     <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static view:EnumMainWindowPage.SettingsRunners}"><Setter Property="Background" Value="{DynamicResource SettingsNavSelectedBrush}" /><Setter Property="FontWeight" Value="Medium" /></DataTrigger>
    </Style.Triggers></Style></Button.Style>
   </Button>
  </StackPanel>
  <ContentControl x:Name="PageContent" Grid.Column="1" s:View.Model="{Binding SelectedViewModel}" />
 </Grid>
</UserControl>
