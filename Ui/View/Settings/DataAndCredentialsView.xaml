<UserControl x:Class="_1RM.View.Settings.DataAndCredentialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="https://github.com/canton7/Stylet">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/1Remote;component/Resources/Theme/SettingsForm.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,20,20">
                <TextBlock Text="{DynamicResource Settings.DataAndCredentials}" Style="{StaticResource SettingsFormPageTitleStyle}" />
                <ContentControl MaxHeight="280" s:View.Model="{Binding DataSources}" />
                <Border Height="1" Background="{DynamicResource ProtocolCardDividerBrush}" Margin="24,18,4,18" />
                <ContentControl MaxHeight="430" s:View.Model="{Binding Credentials}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
