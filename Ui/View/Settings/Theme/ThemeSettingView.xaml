<UserControl x:Class="_1RM.View.Settings.Theme.ThemeSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:_1RM.View.Settings.Theme"
             xmlns:colorPickerWpf="clr-namespace:ColorPickerWPF;assembly=Shawn.Utils.Wpf"
             xmlns:controls="clr-namespace:_1RM.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ThemeSettingViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/1Remote;component/Resources/Theme/SettingsForm.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer>

        <StackPanel>

            <TextBlock Text="{DynamicResource Settings.Appearance}" Style="{StaticResource SettingsFormPageTitleStyle}" />

            <Grid Style="{StaticResource GridOneRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource SettingsFormLabelColumnStyle}"/>
                    <ColumnDefinition Style="{StaticResource SettingsFormInputColumnStyle}"/>
                    <ColumnDefinition Style="{StaticResource SettingsFormActionColumnStyle}"/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource SettingsFormLabelStyle}" Text="{DynamicResource Theme}"></TextBlock>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ThemeList}"
                          SelectedItem="{Binding ThemeName}">
                    <ComboBox.ItemTemplate><DataTemplate><controls:LocalizedOptionText Value="{Binding}" ResourcePrefix="ThemePreset." /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2" HorizontalAlignment="Left" Margin="8 0 0 0" Style="{StaticResource FormActionButtonStyle}" Content="{DynamicResource Reset}" Command="{Binding CmdResetTheme}"></Button>
            </Grid>


            <Expander x:Name="CustomColorsExpander" IsExpanded="False" Style="{StaticResource SettingsColorExpanderStyle}">
            <Grid HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource SettingsFormLabelColumnStyle}"/>
                    <ColumnDefinition Width="0"></ColumnDefinition>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                    <ColumnDefinition Width="70"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                        <Setter Property="TextAlignment" Value="Center"></Setter>
                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                    </Style>
                    <Style TargetType="{x:Type colorPickerWpf:ColorPickRowPopup}">
                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                        <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                        <Setter Property="HexVisible" Value="Collapsed"></Setter>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource Normal}"></TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Lighter}"></TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="{DynamicResource Darker}"></TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="5" Text="{DynamicResource Font}"></TextBlock>

                <TextBlock Style="{StaticResource SettingsFormLabelStyle}" Grid.Row="1" Grid.Column="0" Text="{DynamicResource Color1}"></TextBlock>
                <colorPickerWpf:ColorPickRowPopup Grid.Row="1" Grid.Column="2" HexColor="{Binding PrimaryMidColor}" />
                <colorPickerWpf:ColorPickRowPopup Grid.Row="1" Grid.Column="3" HexColor="{Binding PrimaryLightColor}" />
                <colorPickerWpf:ColorPickRowPopup Grid.Row="1" Grid.Column="4" HexColor="{Binding PrimaryDarkColor}" />
                <colorPickerWpf:ColorPickRowPopup Grid.Row="1" Grid.Column="5" HexColor="{Binding PrimaryTextColor}" />

                <TextBlock Style="{StaticResource SettingsFormLabelStyle}" Grid.Row="2" Grid.Column="0" Text="{DynamicResource Color2}"></TextBlock>
                <colorPickerWpf:ColorPickRowPopup Grid.Row="2" Grid.Column="2" HexColor="{Binding AccentMidColor}" />
                <colorPickerWpf:ColorPickRowPopup Grid.Row="2" Grid.Column="3" HexColor="{Binding AccentLightColor}" />
                <colorPickerWpf:ColorPickRowPopup Grid.Row="2" Grid.Column="4" HexColor="{Binding AccentDarkColor}" />
                <colorPickerWpf:ColorPickRowPopup Grid.Row="2" Grid.Column="5" HexColor="{Binding AccentTextColor}" />

                <TextBlock Style="{StaticResource SettingsFormLabelStyle}" Grid.Row="3" Grid.Column="0" Text="{DynamicResource Background}"></TextBlock>
                <colorPickerWpf:ColorPickRowPopup Grid.Row="3" Grid.Column="2" HexColor="{Binding BackgroundColor}" />
                <colorPickerWpf:ColorPickRowPopup Grid.Row="3" Grid.Column="5" HexColor="{Binding BackgroundTextColor}" />
            </Grid>
            </Expander>



            <TextBlock Text="{DynamicResource Settings.Font}" Style="{StaticResource SettingsFormHeadingStyle}" />

            <Grid Style="{StaticResource GridOneRow}">
                <Grid.Resources>
                    <Style x:Key="YaHeiComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemAccentStyle}">
                        <Setter Property="FontFamily" Value="Microsoft YaHei"></Setter>
                    </Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxAccentStyle}">
                        <Setter Property="FontFamily" Value="Microsoft YaHei"></Setter>
                        <Setter Property="ItemContainerStyle" Value="{StaticResource YaHeiComboBoxItemStyle}" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource SettingsFormLabelColumnStyle}"/>
                    <ColumnDefinition Style="{StaticResource SettingsFormInputColumnStyle}"/>
                    <ColumnDefinition Style="{StaticResource SettingsFormActionColumnStyle}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingsFormLabelStyle}" Text="{DynamicResource Settings.FontFamily}" FontFamily="Microsoft YaHei"></TextBlock>

                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          IsEditable="True" IsTextSearchEnabled="True"
                          FontFamily="Microsoft YaHei"
                          ItemsSource="{Binding FontFamilies}"
                          SelectedItem="{Binding FontFamily}"
                          >
                </ComboBox>
            </Grid>

            <Grid Style="{StaticResource GridOneRow}">
                <Grid.Resources>
                    <Style x:Key="YaHeiComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemAccentStyle}">
                        <Setter Property="FontFamily" Value="Microsoft YaHei"></Setter>
                    </Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxAccentStyle}">
                        <Setter Property="FontFamily" Value="Microsoft YaHei"></Setter>
                        <Setter Property="ItemContainerStyle" Value="{StaticResource YaHeiComboBoxItemStyle}" />
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource SettingsFormLabelColumnStyle}"/>
                    <ColumnDefinition Style="{StaticResource SettingsFormInputColumnStyle}"/>
                    <ColumnDefinition Style="{StaticResource SettingsFormActionColumnStyle}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingsFormLabelStyle}" Text="{DynamicResource Settings.FontSize}" FontFamily="Microsoft YaHei"></TextBlock>

                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          IsEditable="False"
                          SelectedItem="{Binding FontSize}"
                          ItemsSource="{Binding FontSizeOptions}"
                          FontFamily="Microsoft YaHei">
                    <ComboBox.ItemTemplate><DataTemplate><controls:LocalizedOptionText Value="{Binding Name}" ResourcePrefix="Settings.FontSize." /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </StackPanel>

        </ScrollViewer>
    </Grid>
</UserControl>
