<styles:WindowChromeBase x:Class="_1RM.View.AboutPageView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:controls="clr-namespace:Shawn.Utils.Wpf.Controls;assembly=Shawn.Utils.Wpf"
                         xmlns:Rm="clr-namespace:_1RM"
                         xmlns:branding="clr-namespace:_1RM.Controls"
                         xmlns:styles="clr-namespace:Shawn.Utils.WpfResources.Theme.Styles;assembly=Shawn.Utils.WpfResources"
                         ShowInTaskbar="False" WindowStyle="None" ResizeMode="NoResize"
                         Background="Transparent" AllowsTransparency="True" SizeToContent="WidthAndHeight">
    <Border Width="760" Background="{DynamicResource PrimaryMidBrush}"
            BorderBrush="{DynamicResource PrimaryLightBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
        <Grid Margin="24,22">
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeBody}" />
                </Style>
                <Style x:Key="AboutSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                    <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeSubtitle}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentMidBrush}" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
                <Style TargetType="Hyperlink">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="TextDecorations" Value="{x:Null}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentMidBrush}" />
                            <Setter Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <ScrollViewer x:Name="ScrollViewerMain" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,4,0,0">
                        <branding:AppLogo x:Name="ProductLogo" Width="128" Height="128" HorizontalAlignment="Left" />
                        <TextBlock Text="{x:Static Rm:Assert.APP_DISPLAY_NAME}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentMidBrush}" Margin="0,16,0,6" />
                        <TextBlock Text="{DynamicResource Shell.AboutTagline}" Opacity="0.75" TextWrapping="Wrap" />
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="{DynamicResource Shell.Version}" Opacity="0.65" FontSize="12" />
                            <TextBlock Text="{Binding CurrentVersion}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewVersion}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding NewVersion}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource Shell.Update}" Opacity="0.65" FontSize="12" />
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="{Binding NewVersionUrl}" controls:HyperlinkHelper.IsOpenExternal="True">
                                    <Run Text="{Binding NewVersion}" />
                                </Hyperlink>
                            </TextBlock>
                            <Button Command="{Binding CmdUpdate}" Content="{Binding UpdateAction, Mode=OneWay}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateReady}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.75" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Shell.Support}" Style="{StaticResource AboutSectionTitle}" />
                        <TextBlock TextWrapping="Wrap">
                            <Hyperlink NavigateUri="https://yuzhounh.github.io/xRemote/" controls:HyperlinkHelper.IsOpenExternal="True">
                                <Run Text="{DynamicResource about_page_how_to_use}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource Shell.Components}" Style="{StaticResource AboutSectionTitle}" Margin="0,24,0,10" />
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/1Remote/1Remote" controls:HyperlinkHelper.IsOpenExternal="True">https://github.com/1Remote/1Remote</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://www.chiark.greenend.org.uk/~sgtatham/putty/" controls:HyperlinkHelper.IsOpenExternal="True">https://www.chiark.greenend.org.uk/~sgtatham/putty/</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/ButchersBoy/Dragablz" controls:HyperlinkHelper.IsOpenExternal="True">https://github.com/ButchersBoy/Dragablz</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/drogoganor/ColorPickerWPF" controls:HyperlinkHelper.IsOpenExternal="True">https://github.com/drogoganor/ColorPickerWPF</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/VShawn/VariableKeywordMatcher" controls:HyperlinkHelper.IsOpenExternal="True">https://github.com/VShawn/VariableKeywordMatcher</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/praeclarum/sqlite-net" controls:HyperlinkHelper.IsOpenExternal="True">https://github.com/praeclarum/sqlite-net</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/AlexAkulov/putty-color-themes" controls:HyperlinkHelper.IsOpenExternal="True">https://github.com/AlexAkulov/putty-color-themes</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/xiangyuecn/RSA-csharp" controls:HyperlinkHelper.IsOpenExternal="True">https://github.com/xiangyuecn/RSA-csharp</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/robinrodricks/FluentFTP" controls:HyperlinkHelper.IsOpenExternal="True">https://github.com/robinrodricks/FluentFTP</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/sshnet/SSH.NET" controls:HyperlinkHelper.IsOpenExternal="True">https://github.com/sshnet/SSH.NET</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/icsharpcode/AvalonEdit" controls:HyperlinkHelper.IsOpenExternal="True">https://github.com/icsharpcode/AvalonEdit</Hyperlink>
                            </TextBlock>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
            <Button x:Name="CloseAboutButton" Command="{Binding CmdClose}" IsCancel="True" Background="Transparent"
                    Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"
                    Width="40" Height="40" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                    ToolTip="{DynamicResource Close}" AutomationProperties.Name="{DynamicResource Close}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                            <Border x:Name="CloseSurface" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource MenuHoverBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource MenuHoverBrush}" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseSurface" Property="Opacity" Value="0.7" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style>
                </Button.Style>
                <Path Width="10" Height="10" Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>
    </Border>
</styles:WindowChromeBase>
