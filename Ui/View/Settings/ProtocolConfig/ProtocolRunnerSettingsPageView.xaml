<UserControl x:Class="_1RM.View.Settings.ProtocolConfig.ProtocolRunnerSettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uiText="clr-namespace:_1RM.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
             xmlns:protocolConfig="clr-namespace:_1RM.View.Settings.ProtocolConfig"
             xmlns:default="clr-namespace:_1RM.Model.ProtocolRunner.Default"
             xmlns:runner="clr-namespace:_1RM.Model.ProtocolRunner"
             xmlns:controls="clr-namespace:Shawn.Utils.Wpf.Controls;assembly=Shawn.Utils.Wpf"
             d:DataContext="{d:DesignInstance protocolConfig:ProtocolRunnerSettingsPageViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" uiText:EditorValidation.Enabled="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProtocolConfiogDictionary.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                <Setter Property="Foreground" Value="{DynamicResource BackgroundTextBrush}"></Setter>
            </Style>

            <Style x:Key="ListBoxForProtocols" TargetType="ListBox">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeBody}" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="40" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,1" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ProtocolNavHoverBrush}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ProtocolNavSelectedBrush}" />
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentMidBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListBoxRunners" TargetType="{x:Type ListBox}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="AlternationCount" Value="2147483647" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <StackPanel Margin="0">
                                            <Border x:Name="SectionSeparator" Height="1" Margin="0,8,0,2" HorizontalAlignment="Center"
                                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ProtocolCardWidthConverter}}"
                                                Background="{DynamicResource ProtocolCardDividerBrush}" />
                                            <uiText:RunnerSettingsExpander Runner="{Binding}"
                                                SelectedRunner="{Binding DataContext.SelectedRunner, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                Style="{StaticResource RunnerSettingsExpanderStyle}">
                                                <uiText:RunnerSettingsExpander.Header>
                                                    <uiText:LocalizedOptionText Value="{Binding Name}" ResourcePrefix="RunnerName."
                                                        FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                        Foreground="{DynamicResource BackgroundTextBrush}" />
                                                </uiText:RunnerSettingsExpander.Header>
                                                <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Stretch" />
                                            </uiText:RunnerSettingsExpander>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter TargetName="SectionSeparator" Property="Visibility" Value="Collapsed" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>



            <DataTemplate DataType="{x:Type default:InternalDefaultRunner}">
                <Grid Style="{StaticResource Block}">
                    <Grid.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=Border1}" />
                    </Grid.OpacityMask>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Border Name="Border1" Grid.Row="0" Grid.RowSpan="2"
                            Style="{StaticResource ProtocolCardSurfaceStyle}">
                    </Border>
                    <Grid Grid.Row="1" MinHeight="50">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource BackgroundTextBrush}" Text="{DynamicResource Settings.NoExtraOptions}" />
                    </Grid>
                </Grid>
            </DataTemplate>







            <DataTemplate DataType="{x:Type default:KittyRunner}">
                <protocolConfig:KittyRunnerSettings Runner="{Binding}"></protocolConfig:KittyRunnerSettings>
            </DataTemplate>


            <DataTemplate DataType="{x:Type default:PuttyRunner}">
                <protocolConfig:PuttyRunnerSettings Runner="{Binding}"></protocolConfig:PuttyRunnerSettings>
            </DataTemplate>

            <protocolConfig:ConverterExternalRunner2Vm x:Key="ExternalRunner2Vm"></protocolConfig:ConverterExternalRunner2Vm>



            <DataTemplate DataType="{x:Type runner:ExternalRunnerForSSH}">
                <protocolConfig:ExternalSshRunnerSettings DataContext="{Binding Path=., Converter={StaticResource ExternalRunner2Vm}}"></protocolConfig:ExternalSshRunnerSettings>
            </DataTemplate>


            <DataTemplate DataType="{x:Type runner:ExternalRunner}">
                <protocolConfig:ExternalRunnerSettings DataContext="{Binding Path=., Converter={StaticResource ExternalRunner2Vm}}"></protocolConfig:ExternalRunnerSettings>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid MinWidth="130" Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="1" ItemsSource="{Binding Protocols}"
                             SelectedItem="{Binding SelectedProtocol}"
                             Style="{StaticResource ListBoxForProtocols}">
                </ListBox>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" ClipToBounds="True">
            <Grid x:Name="RunnerArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <ListBox x:Name="RunnersList" Grid.Row="2" ScrollViewer.CanContentScroll="False"
                         Style="{StaticResource ListBoxRunners}" Grid.IsSharedSizeScope="True"
                         ItemsSource="{Binding Runners}" Background="{DynamicResource ProtocolSettingsSurfaceBrush}" />

                <uiText:PixelHeaderBorder Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource BackgroundBrush}" />


                <Grid x:Name="DefaultRunnerRow" Grid.Row="1" Width="580" HorizontalAlignment="Left" Margin="15,3,0,3" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Style="{StaticResource ProtocolActionColumnStyle}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Settings.DefaultRunner}" Style="{StaticResource TextBlockTitleColumn}" />

                    <ComboBox x:Name="DefaultRunnerSelector" Grid.Column="1"
                              ItemsSource="{Binding Runners, UpdateSourceTrigger=PropertyChanged}"
                              SelectedItem="{Binding SelectedRunner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate><DataTemplate><uiText:LocalizedOptionText Value="{Binding Name}" ResourcePrefix="RunnerName." /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>


                    <StackPanel Grid.Column="2" Style="{StaticResource ProtocolActionRailStyle}">
                        <uiText:ProtocolHelpButton NavigateUri="https://github.com/yuzhounh/xRemote/blob/main/docs/external-runners.md#configuration" Style="{StaticResource ProtocolHelpButtonStyle}"/>
                    <Button
                            Margin="0"
                            Background="Transparent"
                            attachProperty:VisionElement.BackgroundAccent="Transparent"
                            attachProperty:VisionElement.BackgroundOnMouseDown="Transparent"
                            Style="{StaticResource FormInlineAddButtonStyle}"
                            HorizontalAlignment="Left"
                            ToolTip="{DynamicResource Settings.AddRunnerHint}" AutomationProperties.Name="{DynamicResource Settings.AddRunnerHint}"
                            Command="{Binding CmdAddRunner}"
                            >
                            <Grid Height="16" Width="16">
                                <Path Data="M 41.888 18.304 L 41.888 23.584 L 23.584 23.584 L 23.584 41.888 L 18.304 41.888 L 18.304 23.584 L 0 23.584 L 0 18.304 L 18.304 18.304 L 18.304 0 L 23.584 0 L 23.584 18.304 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                                  StrokeThickness="2" Stretch="Uniform" />
                            </Grid>
                    </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Column="1" Width="1" HorizontalAlignment="Left"
                Background="{DynamicResource ProtocolCardDividerBrush}" IsHitTestVisible="False" />
    </Grid>
</UserControl>
