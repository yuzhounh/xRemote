<UserControl x:Class="_1RM.View.Launcher.ServerSelectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_1RM.View.Launcher"
             xmlns:model="clr-namespace:_1RM.Model"
             xmlns:view="clr-namespace:_1RM.View"
             xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
             xmlns:s="https://github.com/canton7/Stylet"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance local:ServerSelectionsViewModel}"
             d:DesignHeight="450" d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary  Source="LauncherDictionary.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TextBlockTagStringStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                <Setter Property="Opacity" Value="0.5"></Setter>
                <Setter Property="FontSize" Value="10"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"></Setter>
                <Setter Property="Margin" Value="5 0 0 0"></Setter>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"></Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"></Setter>
                        <Setter Property="Opacity" Value="0.8"></Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TextBlocProtocolNameStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                <Setter Property="Opacity" Value="0.3"></Setter>
                <Setter Property="FontSize" Value="16"></Setter>
                <Setter Property="FontWeight" Value="Bold"></Setter>
                <Setter Property="HorizontalAlignment" Value="Right"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"></Setter>
                <Setter Property="TextAlignment" Value="Right"></Setter>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"></Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"></Setter>
                        <Setter Property="Opacity" Value="0.7"></Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate DataType="{x:Type view:ProtocolBaseViewModel}">
                <Grid Height="{x:Static view:LauncherWindowViewModel.LAUNCHER_SERVER_LIST_ITEM_HEIGHT}">
                    <Grid Margin="12,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Source="{Binding Server.IconImg}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ContentControl x:Name="LauncherConnectionTitle" ToolTip="{Binding DisplayName}" s:View.Model="{Binding LauncherMainTitleViewModel}">
                                <ContentControl.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                        <Setter Property="FontSize" Value="{DynamicResource LauncherTitleFontSize}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentControl.Resources>
                            </ContentControl>
                            <ContentControl x:Name="LauncherConnectionDetail" Margin="0,3,0,0" ToolTip="{Binding SubTitle}" s:View.Model="{Binding LauncherSubTitleViewModel}"
                                Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ServerSelectionsView}}, Path=DataContext.ShowCredentials, Converter={StaticResource ConverterBool2Visible}}">
                                <ContentControl.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                        <Setter Property="FontSize" Value="{DynamicResource LauncherDetailFontSize}" />
                                        <Setter Property="Foreground" Value="{DynamicResource LauncherSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentControl.Resources>
                            </ContentControl>
                        </StackPanel>
                        <Button Grid.Column="2" Width="28" Height="28" Margin="8,0,0,0" Background="Transparent" ToolTip="按 ← 显示或隐藏备注"
                            Visibility="{Binding Server.Note, Converter={StaticResource ConverterNoteToVisibility}}"
                            Tag="{Binding Server.Id}" PreviewMouseDown="ButtonShowNote_OnClick"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=view:LauncherWindowView}, Path=DataContext.ServerSelectionsViewModel.CmdShowNoteField}"
                            IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=view:LauncherWindowView}, Path=DataContext.ServerSelectionsViewModel.IsShowNoteFieldEnabled}"
                            Style="{StaticResource ButtonBarPrimaryStyle}">
                            <Path Data="{StaticResource NoteGeometry}" Width="12" Height="12" Fill="{DynamicResource LauncherSecondaryBrush}" Stretch="Uniform" />
                        </Button>
                        <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="94">
                            <Border CornerRadius="4" Padding="6,3" Background="{DynamicResource LauncherHoverBrush}" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Server.ProtocolDisplayName}" FontSize="{DynamicResource LauncherDetailFontSize}" FontWeight="Medium" Foreground="{DynamicResource LauncherSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding TagString}" Style="{StaticResource LauncherOptionalTextStyle}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource LauncherSecondaryBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding DataSourceNameForLauncher}" Style="{StaticResource LauncherOptionalTextStyle}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource LauncherSecondaryBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource LauncherSurfaceBrush}">

        <!--servers list title-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Name="GridKeyword"
                  Width="{x:Static view:LauncherWindowViewModel.LAUNCHER_LIST_AREA_WIDTH}" 
                  Height="{x:Static view:LauncherWindowViewModel.LAUNCHER_GRID_KEYWORD_HEIGHT}">
                <Path Data="M 11,11 L 16,16 M 13,7 A 6,6 0 1 1 1,7 A 6,6 0 1 1 13,7" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource LauncherSecondaryBrush}" StrokeThickness="1.3" Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox Name="TbKeyWord"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         PreviewKeyDown="TbKeyWord_OnPreviewKeyDown"
                         Margin="44 0 16 0"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchBoxTbKeyWordStyleBase}" Tag="{DynamicResource Launcher.SearchHint}"></TextBox>

                <!-- show tags -->
                <Grid Height="40" HorizontalAlignment="Right" Visibility="{Binding TagFilters.Count, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter='0'}">
                    <ItemsControl VerticalAlignment="Center" HorizontalAlignment="Center" ItemsSource="{Binding TagFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="model:TagFilter">
                                <Border VerticalAlignment="Center" Background="{DynamicResource AccentMidBrush}" CornerRadius="5" Margin="3 0">
                                    <Grid ToolTip="{Binding TagName}">
                                        <TextBlock Text="{Binding TagName}" 
                                                   Foreground="{DynamicResource AccentTextBrush}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                            <Setter Property="TextDecorations">
                                                                <Setter.Value>
                                                                    <TextDecorationCollection>
                                                                        <TextDecoration Location="Strikethrough">
                                                                            <TextDecoration.Pen>
                                                                                <Pen Brush="{DynamicResource PrimaryMidBrush}" Thickness="3"></Pen>
                                                                            </TextDecoration.Pen>
                                                                        </TextDecoration>
                                                                    </TextDecorationCollection>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>


            <!--servers list body-->
            <ListBox x:Name="ListBoxSelections"
                     Grid.Row="1"
                     Grid.IsSharedSizeScope="True"
                     BorderThickness="0"
                     PreviewMouseRightButtonDown="ListBoxSelections_OnMouseRightButtonDown"
                     PreviewMouseLeftButtonDown="ListBoxSelections_OnPreviewMouseLeftButtonDown"
                     SelectedIndex="{Binding SelectedIndex}"
                     ItemsSource="{Binding VmServerList}"
                     Style="{StaticResource SearchBoxSelectionList}">
            </ListBox>

        </Grid>


        <!--actions of selected server-->
        <Grid Name="GridActionsList" Visibility="Hidden" Background="{DynamicResource LauncherSurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Width="{x:Static view:LauncherWindowViewModel.LAUNCHER_LIST_AREA_WIDTH}" 
                  Height="{x:Static view:LauncherWindowViewModel.LAUNCHER_GRID_KEYWORD_HEIGHT}">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"></ColumnDefinition>
                        <ColumnDefinition Width="30"></ColumnDefinition>
                        <ColumnDefinition Width="5"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Background="{DynamicResource LauncherSurfaceBrush}" MouseDown="ButtonActionBack_OnMouseDown">
                        <Path Margin="2" Fill="{DynamicResource PrimaryLightBrush}" Height="25" Data="F1 M 16.591797 2.431641 L 9.023438 10 L 16.591797 17.568359 L 14.238281 19.931641 L 4.306641 10 L 14.238281 0.068359 L 16.591797 2.431641 Z " Stretch="Uniform"></Path>
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="1">
                        <Image Source="{Binding SelectedItem.Server.IconImg}" Width="{Binding Path=Width, RelativeSource={RelativeSource FindAncestor,AncestorType=Grid}}"></Image>
                    </Grid>

                    <Grid Grid.Column="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{StaticResource TextBlockBase}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource LauncherTitleFontSize}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectedItem.Server.DisplayName}"></TextBlock>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0" Opacity="0.6">
                            <TextBlock Style="{StaticResource TextBlockBase}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource GlobalFontSizeBody}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Top"
                                       Text="{Binding SelectedItem.Server.SubTitle}"></TextBlock>
                        </Grid>

                        <TextBlock Style="{StaticResource TextBlockBase}"
                                   Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                   Text="{Binding SelectedItem.Server.ProtocolDisplayName}"
                                   FontSize="{DynamicResource LauncherTitleFontSize}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryMidBrush}"
                                   Opacity="0.4"
                                   HorizontalAlignment="Right"
                                   Margin="10 0"
                                   VerticalAlignment="Center"></TextBlock>
                        <TextBlock Style="{StaticResource TextBlockBase}"
                                   Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                   Text="{Binding SelectedItem.Server.ProtocolDisplayName}"
                                   FontSize="{DynamicResource LauncherTitleFontSize}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Opacity="0.2"
                                   HorizontalAlignment="Right"
                                   Margin="10 0"
                                   VerticalAlignment="Center"></TextBlock>
                    </Grid>
                </Grid>
            </Grid>

            <ListBox x:Name="ListBoxActions"
                     Grid.Row="1"
                     PreviewMouseRightButtonDown="ListBoxActions_OnMouseRightButtonDown"
                     PreviewMouseDoubleClick="ListBoxActions_OnMouseDoubleClick"
                     Style="{StaticResource SearchBoxActionList}"
                     BorderThickness="0"
                     SelectedIndex="{Binding SelectedActionIndex}"
                     ItemsSource="{Binding Actions}">
            </ListBox>
        </Grid>

    </Grid>
</UserControl>
