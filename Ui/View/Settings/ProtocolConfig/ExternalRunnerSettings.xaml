<?xml version="1.0" ?><protocolConfig:ExternalRunnerSettingsBase xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources" xmlns:controls="clr-namespace:_1RM.Controls" xmlns:controls1="clr-namespace:Shawn.Utils.Wpf.Controls;assembly=Shawn.Utils.Wpf" xmlns:protocolConfig="clr-namespace:_1RM.View.Settings.ProtocolConfig" xmlns:layout="clr-namespace:_1RM.Controls" x:Class="_1RM.View.Settings.ProtocolConfig.ExternalRunnerSettings" mc:Ignorable="d" d:DataContext="{d:DesignInstance protocolConfig:ExternalRunnerSettingsViewModel}" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProtocolConfiogDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource Block}">
        <Grid.OpacityMask>
            <VisualBrush Visual="{Binding ElementName=Border1}"/>
        </Grid.OpacityMask>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Name="Border1" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource ProtocolCardSurfaceStyle}">
        </Border>
        <StackPanel Grid.Row="1">
            <Grid Height="8"/>

            <Grid Style="{StaticResource GridOneRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExternalRunnerColumn1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Style="{StaticResource ProtocolActionColumnStyle}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TextBlockTitleColumn}" Text="{DynamicResource 'Exe path'}"/>
                <TextBox Grid.Column="1" Text="{Binding ExternalRunner.ExePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ExternalRunner.ExePath}" TextWrapping="Wrap" VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxAccentStyle}">
                            <Style.Triggers>
                                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ExternalRunner.IsExeExisted}" Value="False"/><Condition Binding="{Binding (layout:EditorValidation.Touched), RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource ValidationErrorBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ToolTip" Value="{DynamicResource Settings.ProgramMissing}"/></MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Grid.Column="2" Style="{StaticResource FormActionButtonStyle}" Margin="5 0 0 0" VerticalAlignment="Top" HorizontalAlignment="Left" Content="{DynamicResource Select}" Command="{Binding CmdSelectExePath}"/>
            </Grid>


            <Grid Style="{StaticResource GridOneRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExternalRunnerColumn1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Style="{StaticResource ProtocolActionColumnStyle}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TextBlockTitleColumn}" Text="{DynamicResource 'Cmd parameter'}"/>
                <Border Grid.Column="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="5"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DefaultBorderBrush}"/>
                            <Setter Property="Padding" Value="5 1"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ElementName=TextEditor, Path=IsMouseOver}" Value="True"/>
                                        <Condition Binding="{Binding ElementName=TextEditor, Path=TextArea.IsFocused}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentMidBrush}"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding ElementName=TextEditor, Path=TextArea.IsFocused}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentMidBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <controls:BindableAvalonEditor Grid.Column="1" Margin="8 0 4 0" Padding="0 5 0 5" x:Name="TextEditor" WordWrap="True" MinWidth="200" Background="Transparent" Text="{Binding ExternalRunner.Arguments}" SyntaxHighlighting="PowerShell" FontSize="{DynamicResource TextFontSize}">
                </controls:BindableAvalonEditor>

                <StackPanel Grid.Column="2" Style="{StaticResource ProtocolActionRailStyle}">
                    <layout:ProtocolHelpButton NavigateUri="https://github.com/yuzhounh/xRemote/blob/main/docs/external-runners.md#configuration" Style="{StaticResource ProtocolHelpButtonStyle}" ToolTip="{DynamicResource Editor.ConfigHelp}" AutomationProperties.Name="{DynamicResource Editor.ConfigHelp}"/>
                    <layout:ProtocolHelpButton Command="{Binding DataContext.CmdShowProtocolHelp, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type protocolConfig:ProtocolRunnerSettingsPageView}}}" Style="{StaticResource ProtocolHelpButtonStyle}" ToolTip="{DynamicResource Editor.ParameterVariablesHint}" AutomationProperties.Name="{DynamicResource Editor.ParameterVariablesHint}" Tag="Info"/>
                </StackPanel>
            </Grid>



            <Grid Style="{StaticResource GridOneRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExternalRunnerColumn1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Style="{StaticResource ProtocolActionColumnStyle}"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBlockTitleColumn}" Text="{DynamicResource 'Environment variables'}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.ColumnSpan="2">

                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Left" MaxWidth="420" Margin="0" FontSize="{DynamicResource GlobalFontSizeSmall}" Text="{DynamicResource 'Before runner start the environment variables will be set'}" Opacity="0.8"/>

                    <ListBox ItemsSource="{Binding ExternalRunner.EnvironmentVariables}" BorderThickness="0" Background="Transparent" Padding="0" HorizontalContentAlignment="Stretch" Template="{StaticResource ProtocolPairListTemplate}">
                        <ListBox.Style>
                            <Style TargetType="{x:Type ListBox}">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="ItemContainerStyle">
                                    <Setter.Value>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Grid Margin="0,4">
                                                            <Border x:Name="GridContainer"/>
                                                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Stretch"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Style="{StaticResource ProtocolActionColumnStyle}"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Margin="0,0,6,0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource Settings.EnvironmentNamePlaceholder}" ToolTip="{DynamicResource Settings.EnvironmentKeyHint}"/>

                                    <controls:AutoCompleteComboBox Grid.Column="1" Margin="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Selections="{Binding DataContext.ExternalRunner.MarcoNames, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type protocolConfig:ExternalRunnerSettingsBase}}}" Tag="{DynamicResource Settings.EnvironmentValuePlaceholder}" ToolTip="{DynamicResource Settings.EnvironmentValueHint}"/>

                                    <Button Grid.Column="2" Width="28" Height="28" ToolTip="{DynamicResource 'Delete'}" Style="{StaticResource ButtonBarTransparentStyle}" HorizontalAlignment="Left" Opacity="0.8" Command="{Binding DataContext.CmdDelEnvironmentVariable, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type protocolConfig:ExternalRunnerSettingsBase}}}" CommandParameter="{Binding }" Margin="5,0,0,0">
                                        <Grid Height="10" Width="8">
                                            <Path Data="F1 M 47.910156 -44.000000 L 87.183594 -4.683594 L 83.316406 -0.816406 L 44.000000 -40.089844 L 4.683594 -0.816406 L 0.816406 -4.683594 L 40.089844 -44.000000 L 0.816406 -83.316406 L 4.683594 -87.183594 L 44.000000 -47.910156 L 83.316406 -87.183594 L 87.183594 -83.316406 Z " Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}" Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}" StrokeThickness="2" Stretch="Uniform"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Margin="0" ToolTip="{DynamicResource 'Add environment variables'}" Style="{StaticResource LeftAlignedAddButtonStyle}" HorizontalAlignment="Left" Command="{Binding CmdAddEnvironmentVariable}" />
                </StackPanel>
            </Grid>




            <Grid Style="{StaticResource GridOneRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExternalRunnerColumn1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Style="{StaticResource ProtocolActionColumnStyle}"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource TextBlockTitleColumn}" Text="{DynamicResource Settings.SpecialCharacters}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Style="{StaticResource ProtocolActionColumnStyle}"/></Grid.ColumnDefinitions>
                        <TextBlock TextWrapping="Wrap" Margin="0" FontSize="{DynamicResource GlobalFontSizeSmall}" Text="{DynamicResource Settings.SpecialCharacterHint}" Opacity="0.8"/>
                        <StackPanel Grid.Column="1" Style="{StaticResource ProtocolActionRailStyle}"><layout:ProtocolHelpButton NavigateUri="https://github.com/yuzhounh/xRemote/blob/main/docs/external-runners.md#special-characters" Style="{StaticResource ProtocolHelpButtonStyle}" ToolTip="{DynamicResource Editor.ConfigHelp}" AutomationProperties.Name="{DynamicResource Editor.ConfigHelp}"/></StackPanel>
                    </Grid>
                    <ListBox ItemsSource="{Binding ExternalRunner.SpecialCharacters}" BorderThickness="0" Background="Transparent" Padding="0" HorizontalContentAlignment="Stretch" Template="{StaticResource ProtocolPairListTemplate}">
                        <ListBox.Style>
                            <Style TargetType="{x:Type ListBox}">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="ItemContainerStyle">
                                    <Setter.Value>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Grid Margin="0,4">
                                                            <Border x:Name="GridContainer"/>
                                                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Stretch"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Style="{StaticResource ProtocolActionColumnStyle}"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Margin="0,0,6,0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource Settings.SpecialSourcePlaceholder}" ToolTip="{DynamicResource Settings.SpecialSourceHint}"/>


                                    <TextBox Grid.Column="1" Margin="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource Settings.SpecialReplacementPlaceholder}" ToolTip="{DynamicResource Settings.SpecialReplacementHint}"/>

                                    <Button Grid.Column="2" Width="28" Height="28" ToolTip="{DynamicResource Settings.DeleteSpecialHint}" Style="{StaticResource ButtonBarTransparentStyle}" HorizontalAlignment="Left" Opacity="0.8" Command="{Binding DataContext.CmdDelSpecialCharacter, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type protocolConfig:ExternalRunnerSettingsBase}}}" CommandParameter="{Binding }" Margin="5,0,0,0">
                                        <Grid Height="10" Width="8">
                                            <Path Data="F1 M 47.910156 -44.000000 L 87.183594 -4.683594 L 83.316406 -0.816406 L 44.000000 -40.089844 L 4.683594 -0.816406 L 0.816406 -4.683594 L 40.089844 -44.000000 L 0.816406 -83.316406 L 4.683594 -87.183594 L 44.000000 -47.910156 L 83.316406 -87.183594 L 87.183594 -83.316406 Z " Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}" Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}" StrokeThickness="2" Stretch="Uniform"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Margin="0" ToolTip="{DynamicResource Settings.AddSpecialHint}" Style="{StaticResource LeftAlignedAddButtonStyle}" HorizontalAlignment="Left" Command="{Binding CmdAddSpecialCharacter}" />
                </StackPanel>
            </Grid>


            <Grid Style="{StaticResource GridOneRow}" ToolTip="{DynamicResource 'Hosting this exe in 1Remote tab view?'}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExternalRunnerColumn1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Style="{StaticResource ProtocolActionColumnStyle}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TextBlockTitleColumn}" Text="{DynamicResource 'Hosting'}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding ExternalRunner.RunWithHosting}">
                    <TextBlock Foreground="{DynamicResource ReadableAccentTextBrush}" Text="{DynamicResource 'Caution: some exe can not be hosted in 1Remote.'}" TextWrapping="Wrap"/>
                </CheckBox>
            </Grid>
        </StackPanel>
    </Grid>
</protocolConfig:ExternalRunnerSettingsBase>
